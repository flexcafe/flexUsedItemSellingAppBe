[Unit]
Description=Flex Used Market Production API
After=network-online.target redis.service
Wants=network-online.target
Requires=redis.service

[Service]
Type=simple
User=flexapp
Group=flexapp
WorkingDirectory=/opt/flex/current
EnvironmentFile=/opt/flex/shared/.env
Environment=NODE_ENV=production
Environment=PORT=7879
Environment=HOST=127.0.0.1
Environment=NODE_OPTIONS=--max-old-space-size=2048
ExecStart=/opt/node/bin/node /opt/flex/current/dist/src/main.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/flexapp
UMask=0027
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target