# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# Supabase
# Project URL only (Settings → API → Project URL). Do NOT use your Nest base URL, DATABASE_URL host, or paths like /rest/v1 — or Storage uploads return "Route ... /object/... not found".
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
# Must be the service_role key (long JWT under Project Settings → API). Anon key causes "signature verification failed" on storage uploads.
SUPABASE_SERVICE_KEY="your-supabase-service-role-key"
SUPABASE_AVATAR_BUCKET="avatars"
SUPABASE_SLIDER_AD_BUCKET="slider-ads"
SUPABASE_CATEGORY_ICON_BUCKET="category-icons"
# Create these buckets in Supabase Dashboard → Storage (or set names to buckets you already created). Public bucket + policies if you rely on getPublicUrl().
SUPABASE_PRODUCT_IMAGE_BUCKET="listing-images"
SUPABASE_PRODUCT_MAP_BUCKET="listing-images"

# Optional IANA timezone for public product `createdAtDisplay` (catalog + public detail). Default UTC.
# LISTING_DISPLAY_TIMEZONE="Asia/Yangon"

SUPABASE_FACEBOOK_FOLLOW_BUCKET="facebook-follow-submissions"

# Facebook Graph API (for server-verified link flow)
FACEBOOK_APP_ID="your-facebook-app-id"
FACEBOOK_APP_SECRET="your-facebook-app-secret"
# Optional override
# FACEBOOK_GRAPH_BASE_URL="https://graph.facebook.com"
# FACEBOOK_GRAPH_VERSION="v22.0"

# Pusher (Realtime notifications)
PUSHER_APP_ID="your-app-id"
PUSHER_KEY="your-key"
PUSHER_SECRET="your-secret"
PUSHER_CLUSTER="ap1"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRATION="7d"

# Redis (optional locally; recommended in production for Socket.IO + chat rate limits)
# REDIS_URL="redis://127.0.0.1:6379"

# App
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"
# When behind a reverse proxy, set to 1 so rate limits use X-Forwarded-For as client IP
# TRUST_PROXY=1

# Email (Brevo SMTP)
BREVO_SMTP_HOST="smtp-relay.brevo.com"
BREVO_SMTP_PORT=587
BREVO_SMTP_USER="your-brevo-smtp-login"
BREVO_SMTP_PASS="your-brevo-smtp-password"
BREVO_FROM_EMAIL="no-reply@example.com"
BREVO_FROM_NAME="FlexCafe"

# SMS (SMSPoh API v3 — REST send: https://smspoh.com/v3/developers/restful-sms-api-specification )
SMSPOH_API_KEY="your-smspoh-v3-api-key"
SMSPOH_API_SECRET="your-smspoh-v3-api-secret"
SMSPOH_SENDER_ID="YourSenderId"
# Optional: REST JSON base (default https://v3.smspoh.com/api/rest). Do not point this at /api/http unless you only use HTTP-query sends.
# SMSPOH_API_BASE_URL="https://v3.smspoh.com/api/rest"
# HTTP-query send base (default https://v3.smspoh.com/api/http). Used unless SMSPOH_USE_REST_JSON_SEND=true.
# SMSPOH_HTTP_BASE_URL="https://v3.smspoh.com/api/http"
# Use REST JSON POST /send instead of HTTP-query (default false; set true only if you need REST).
# SMSPOH_USE_REST_JSON_SEND="false"
# Log-only hint for SMSPoh (HTTP-query sends omit API `test`; use dashboard for sandbox). true | 1 | yes | on
# SMSPOH_TEST="false"

# Root admin (seed)
ROOT_ADMIN_EMAIL="admin@example.com"
ROOT_ADMIN_PASSWORD="change-me"
ROOT_ADMIN_PHONE="+959000000000"
ROOT_ADMIN_NICKNAME="Root Admin"

# `npm run db:seed` always TRUNCATEs all rows in every `public` table (except
# `_prisma_migrations`), then inserts seed users. Schema and migration files are unchanged.
# Do not run against a production database unless you intend to wipe all data.
