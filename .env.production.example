# Copy to .env.production — live Supabase PRODUCTION project
# Deploy server should use this file as .env (or symlink/copy on VPS).

APP_ENV=production
NODE_ENV=production
PORT=3000
TRUST_PROXY=1

DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_SERVICE_KEY="your-production-service-role-key"

SUPABASE_AVATAR_BUCKET="avatars"
SUPABASE_SLIDER_AD_BUCKET="slider-ads"
SUPABASE_CATEGORY_ICON_BUCKET="category-icons"
SUPABASE_PRODUCT_IMAGE_BUCKET="listing-images"
SUPABASE_PRODUCT_MAP_BUCKET="listing-images"
SUPABASE_FACEBOOK_FOLLOW_BUCKET="facebook-follow-submissions"

JWT_SECRET="use-a-long-random-production-secret"
JWT_EXPIRATION="7d"
ALLOWED_ORIGINS="https://your-frontend-domain.com"

REDIS_URL="redis://your-production-redis:6379"

# Do NOT set SEED_ON_DEPLOY=1 on production unless you intend to wipe all data.
