# Copy to .env.development — Supabase DEV project (local + team testing)
# One Supabase project = one PostgreSQL database. Create a separate project for dev.

APP_ENV=development
NODE_ENV=development
PORT=3000

# Prisma runtime (pooler, port 6543) — Settings → Database → Connection string → URI → "Use connection pooling"
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Prisma migrations (direct, port 5432) — same page, "Direct connection"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_SERVICE_KEY="your-dev-service-role-key"

SUPABASE_AVATAR_BUCKET="avatars"
SUPABASE_SLIDER_AD_BUCKET="slider-ads"
SUPABASE_CATEGORY_ICON_BUCKET="category-icons"
SUPABASE_PRODUCT_IMAGE_BUCKET="listing-images"
SUPABASE_PRODUCT_MAP_BUCKET="listing-images"
SUPABASE_FACEBOOK_FOLLOW_BUCKET="facebook-follow-submissions"

JWT_SECRET="dev-only-change-me"
JWT_EXPIRATION="7d"
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# Optional locally
# REDIS_URL="redis://127.0.0.1:6379"

# Seed wipes all public tables — safe only on dev
ROOT_ADMIN_EMAIL="admin@example.com"
ROOT_ADMIN_PASSWORD="change-me"
ROOT_ADMIN_PHONE="+959000000000"
ROOT_ADMIN_NICKNAME="Root Admin"
